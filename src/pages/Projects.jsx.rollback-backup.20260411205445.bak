    e.preventDefault()
    if (!contractFormData.contractName.trim() || !contractFormData.supplierName.trim()) {
      alert('\u8bf7\u586b\u5199\u5408\u540c\u540d\u79f0\u548c\u4f9b\u5e94\u5546\u540d\u79f0')
      return
    }

    const resolvedProjectId = selectedProject?.id || contractFormData.projectId
    if (!resolvedProjectId) {
      alert('\u8bf7\u5148\u9009\u62e9\u4e00\u4e2a\u9879\u76ee\u518d\u4fdd\u5b58\u5408\u540c')
      return
    }

    try {
      const fd = new FormData()
      const hasSplitAmount = String(contractFormData.amountExclTax).trim() !== '' || String(contractFormData.taxAmount).trim() !== ''
      const resolvedAmount = hasSplitAmount
        ? Number(contractFormData.amountExclTax || 0) + Number(contractFormData.taxAmount || 0)
        : Number(contractFormData.contractAmount || 0)
      fd.append('projectId', String(resolvedProjectId))
      fd.append('contractName', String(contractFormData.contractName || ''))
      fd.append('supplierName', String(contractFormData.supplierName || ''))
      fd.append('contractAmount', String(resolvedAmount))
      fd.append('paymentMethod', String(contractFormData.paymentMethod || ''))
      fd.append('amountExclTax', String(Number(contractFormData.amountExclTax) || 0))
      fd.append('taxAmount', String(Number(contractFormData.taxAmount) || 0))
      fd.append('contractAmountUpper', String(contractFormData.contractAmountUpper || ''))
      fd.append('dateText', String(contractFormData.dateText || ''))
      fd.append('signDate', String(contractFormData.signDate || ''))
      fd.append('deliveryLocation', String(contractFormData.deliveryLocation || ''))
      fd.append('receiver', String(contractFormData.receiver || ''))
      fd.append('buyerName', String(contractFormData.supplierName || contractFormData.contactPerson || ''))
      fd.append('buyerAddress', String(contractFormData.supplierAddress || ''))
      fd.append('buyerBankName', String(contractFormData.buyerBankName || ''))
      fd.append('buyerBankAccount', String(contractFormData.buyerBankAccount || contractFormData.bankAccount || ''))
      const normalizedProjectItems = Array.isArray(projectItems)
        ? projectItems.map((item) => ({ ...item, category: normalizeMaterialType(item?.category) }))
        : []
      fd.append('materialList', JSON.stringify(normalizedProjectItems))
      if (contractFormData.contractFile) {
        fd.append('contractFile', contractFormData.contractFile)
      }

      if (editingContract) {
        await updateSupplierContract(editingContract.id, fd)
        alert('\u5408\u540c\u66f4\u65b0\u6210\u529f')
      } else {
        await createSupplierContract(fd)
        alert('\u5408\u540c\u521b\u5efa\u6210\u529f')
      }

      await loadContracts(resolvedProjectId)
      resetContractForm()
    } catch (e) {
      alert(e.message || '\u5408\u540c\u4fdd\u5b58\u5931\u8d25')
    }
  }

