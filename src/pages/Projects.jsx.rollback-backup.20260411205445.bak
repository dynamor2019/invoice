                onChange={(e) => setProjectSearch(e.target.value)}
                placeholder="闂傚倸鍊搁崐鎼佸磹閹间礁纾归柣鎴ｅГ閸ゅ嫰鏌涢锝嗙缂佺姷濞€閺岀喖骞戦幇闈涙闁荤喐鐟辩粻鎾诲箖濡ゅ懏鏅查幖绮光偓鎰佹交闂備焦鎮堕崝宥囨崲閸儳宓侀柡宥庣仈鎼搭煈鏁嗛柍褜鍓氭穱濠囨嚃閳哄啯锛忛梺璇″瀻娴ｉ晲鍒掗梻浣告惈閺堫剙煤濡吋宕叉繝闈涳功閻も偓濠殿喗锕㈢涵绋课ｉ悷鎵虫斀闁绘劘灏欓幗鐘电磼椤旇偐肖闁告帗甯￠獮妯兼嫚閼艰埖鎲版繝鐢靛仦閸垶宕瑰ú顏勭柧婵犲﹤鐗婇崑锝夋煕閵夛絽濡肩紒鑼跺吹缁辨帡鎮╅悜姗嗕哗缂備浇椴搁幐濠氬箯閸涘瓨鍋￠柡澶嬵儥濞兼梹淇婇悙顏勨偓鎴﹀礉瀹€鍕櫇妞ゅ繐瀚烽崵鏇㈡偣閸ャ劎銈存俊鎻掔墛閹便劌螖閳ь剙螞濞嗘挸纾介梻鍫熶緱濞撳鏌曢崼婵囶棞缂佹甯￠弻娑欑節閸愩劌顫掓繝纰樷偓宕囧煟鐎规洖鐖兼俊鎼佸Ψ閵堝洨姊鹃梻鍌氬€风欢姘焽瑜戞晶婵嬫⒑閸濆嫭鍣虹紒顔芥崌楠炲啴鍨鹃弬銉︾€婚梺鍦亾濞兼瑩鍩€椤掆偓閻忔氨鎹㈠☉銏犵闁绘劕鐏氶崳浠嬫⒑缂佹ê绗╂俊顐㈠閳ワ箓鎳楅锝喰梻浣芥〃缁€渚€鈥﹀畡閭﹀殨濠电姵鑹鹃崡鎶芥煏韫囨洖孝闁兼澘鐏濋埞鎴炲箠闁稿﹥娲熷畷顒勵敇閳藉棙鈻岄梻浣告惈閻ジ宕伴弽顓溾偓浣糕槈濮楀棙鍍靛銈嗗笒椤︻喚妲愰弮鈧穱濠囨倷椤忓嫧鍋撻幋锕€鍨傛繛宸簼閸嬶繝鏌嶆潪鎷屽厡闁哄棴闄勭换婵囩節閸屾冻绱炲┑鈩冨絻閵堢顫忓ú顏咁棃婵炴垶鐟ラˇ鈺冪磽娴ｇ瓔鍤欓柣妤€妫濋敐?"
                className="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none"
              />
            </div>
            {filteredProjects.length === 0 ? (
              <div className="modern-card p-6 text-center animate-fade-in-up">
                <div className="w-12 h-12 bg-gradient-to-br from-gray-100 to-gray-200 rounded-full flex items-center justify-center mx-auto mb-2">
                  <FolderOpen className="text-2xl text-gray-400" />
                </div>
                <h3 className="text-sm font-semibold text-gray-600 mb-1">闂傚倸鍊搁崐鎼佸磹閹间礁纾瑰瀣捣閻棗銆掑锝呬壕濡ょ姷鍋為悧鐘汇€侀弴銏犵厬闁兼亽鍎抽埥澶愭懚閺嶎厽鐓曟繛鎴濆船楠炴﹢鏌ㄥ☉娆戞噰婵﹥妞介幊锟犲Χ閸涱喚鈧箖鏌ｆ惔銏ｅ闁绘妫濋崺銉﹀緞閹邦剦娼婇梺缁樕戦悥鐘诲炊閵娧冨箞闂備焦鏋奸弲娑㈠疮椤愶絾鍙忛柛鎰典簽绾惧ジ鏌曟繛鍨姶闁绘挸鍚嬮幈銊︾節閸愨斂浠㈠┑鈽嗗亜閸熸挳宕洪埄鍐╁闁绘垶顭勯幒妤佲拻濞达絽鎲￠崯鐐淬亜椤撶偞鍠樼€殿喗鐓￠、鏇㈠Χ閸涱厾浜?/h3>
                <p className="text-xs text-gray-500 mb-3">闂傚倸鍊搁崐宄懊归崶顒夋晪鐟滃繘鍩€椤掍胶鈻撻柡鍛█閵嗕礁鈻庨幘鍐插敤濡炪倖鎸鹃崑鐔兼偘閵夆晜鈷戦柛锔诲幖閸斿銇勯妸銉﹀櫧濠㈣娲樼换婵嗩潩椤撶姴骞嶉梻浣虹帛閸旓箓宕滃鑸靛€堕梺顒€绉甸悡娑㈡煃瑜滈崜鐔煎箠閻愬搫唯闁挎繂瀚惄搴ㄦ⒒娴ｅ憡鎯堥柛鐕佸亰瀹曟劙鎮界粙璺唵闂佽法鍠撴慨鐢告偂閺囥垹绠归弶鍫濆⒔绾捐法绱掗悩宸吋闁哄矉绱曟禒锕傚礈瑜庨崚娑欑節绾版ê澧查柟顔煎€规穱濠囨倻閽樺）銊╂煏婵炲灝鍔ら柛妯绘綑閳规垿鏁嶉崟顐℃澀闂佺锕ラ悧鏇犲弲濠殿喗銇涢崑鎾绘煙椤旀儳鍘撮柛鈺嬬節瀹曘劑顢橀悩鍨瘒濠电姷鏁告慨鎾晝閵堝瑙︽慨妞诲亾闁诡喓鍨藉畷銊︾節閸屻倖钂嬮梻鍌欒兌缁垶銆冮崨瀛樺亱闁糕剝绋戦崙鐘绘煏閸繍妲归柍閿嬪浮閺屾稓浠﹂崜褎鍣梺鍛婃煥缁夊綊寮婚敐澶樻晜闁告洦鍘炬闁诲氦顫夊ú妯兼崲閸岀偞鍋╂繝闈涱儏閻掑灚銇勯幒鎴濐仼闁绘帒鐏氶妵鍕箳瀹ュ浂妲梺鎼炲€ら崜鐔煎蓟濞戙垺鏅查煫鍥ㄦ礈琚﹂梻渚€娼уΛ鏃傛濮橆剦鍤曞ù鐘差儛閺佸洭鏌ｉ幇鐗堟锭闁逞屽墰閸嬨倕顫忓ú顏咁棃婵炴番鍊栭惄顖炲春閳ь剚銇勯幒鎴濐仼闁告垹濞€閺屸€愁吋鎼粹€崇闂佹娊鏀遍崹鍨潖濞差亶鏁冮柕鍫濇噸缁爼姊洪崗鍏笺仧闁搞劑浜跺鏌ュ醇閺囥劍鏅┑鐘诧工閹虫劙鏁嶅鍫熺厽閹兼惌鍨崇粔闈浢瑰鍡樼【閾伙綁鏌嶈閸撴瑩鈥旈崘顔嘉ч柛鎰╁妿娴犳儳鈹戦埥鍡椾簻闁哥噥鍋婇幃楣冩倻閼恒儱浜楅柟鐓庣摠钃辨い顐㈢Ч濮婃椽宕烽鐐插闂佹悶鍔忓▍鏇犵博閻旂厧鍗抽柕蹇娾偓鏂ュ亾閸偒娈介柣鎰皺娴犮垽鏌涢弮鈧喊宥夊Φ閸曨垱鏅滈柛顭戝枛缁侇噣鎮?/p>
                {canManageProjects && (
