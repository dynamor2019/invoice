            </div>

            {/* 婵犵數濮烽弫鍛婃叏閻戝鈧倿鎸婃竟鈺嬬秮瀹曘劑寮堕幋鐙呯幢闂備礁鎲℃笟妤呭矗鎼淬劍鍋勯柛鈩兠肩换鍡樸亜閺嶃劍鐨戞慨锝囧仱閺屾稓鈧綆鍋呯亸顓熴亜椤愶絿绠為柟顔瑰墲閹棃濮€閵忕姷绉甸梻鍌氬€峰ù鍥敋閺嶎厼绐楅柡宥冨妽濞呯娀鏌ｉ敐鍛拱妞ゎ偅娲熼弻鐔兼倻濡儤顔曢梺缁樻⒒閸庛倗鈧碍姘ㄩ埀顒傛嚀婢瑰﹪宕伴幒妤€纾婚柟鎹愵嚙缁犺崵绱撴担璇＄劷闁告ü绮欏铏圭磼濡浚浜畷銏ゅ冀椤撶喎娈濆銈呯箰閻楀﹪鎮￠弴銏＄厸闁稿本绻冪涵鍫曞极閸儲鍊垫繛鍫濈仢閺嬫盯鏌ｉ妶鍛窛缂侇喛顕ч埥澶娢熼柨瀣垫綌婵犵數鍋涘Λ娆撳垂閻㈠摜宓佺€广儱妫旂换鍡涙煟閹板吀绨婚柍褜鍓氶悧鐘诲箖瑜嶈灃闁告劑鍔嶉悗鎶芥倵楠炲灝鍔氭い锔诲灦濮婂顢涘鍕瀾闂佺粯顨呴悧鍡欑箔濮樿埖鐓?*/}
            <div className="modern-card p-4 animate-fade-in-up" style={{ animationDelay: '0.6s' }}>
              <h3 className="text-base font-bold text-gray-800 mb-4">婵犵數濮烽弫鍛婃叏閻戝鈧倿鎸婃竟鈺嬬秮瀹曘劑寮堕幋鐙呯幢闂備礁鎲℃笟妤呭矗鎼淬劍鍋勯柛鈩兠肩换鍡樸亜閺嶃劍鐨戞慨锝囧仱閺屾稓鈧綆鍋呯亸顓熴亜椤愶絿绠為柟顔瑰墲閹棃濮€閵忕姷绉甸梻鍌氬€峰ù鍥敋閺嶎厼绐楅柡宥冨妽濞呯娀鏌ｉ敐鍛拱妞ゎ偅娲熼弻鐔兼倻濡儤顔曢梺缁樻⒒閸庛倗鈧碍姘ㄩ埀顒傛嚀婢瑰﹪宕伴幒妤€纾婚柟鎹愵嚙缁犺崵绱撴担璇＄劷闁告ü绮欏铏圭磼濡浚浜畷銏ゅ冀椤撶喎娈濆銈呯箰閻楀﹪鎮￠弴銏＄厸闁稿本绻冪涵鍫曞极閸儲鍊垫繛鍫濈仢閺嬫盯鏌ｉ妶鍛窛缂侇喛顕ч埥澶娢熼柨瀣垫綌婵犵數鍋涘Λ娆撳垂閻㈠摜宓佺€广儱妫旂换鍡涙煟閹板吀绨婚柍褜鍓氶悧鐘诲箖瑜嶈灃闁告劑鍔嶉悗鎶芥倵楠炲灝鍔氭い锔诲灦濮婂顢涘鍕瀾闂佺粯顨呴悧鍡欑箔濮樿埖鐓?/h3>
              <div className="space-y-4">
                {projects.slice(0, 5).map((project, index) => {
                  const totalBudget = Number(project.totalBudget) || 0
                  const usedBudget = totalBudget - (Number(project.balance) || totalBudget)
                  const usagePercent = totalBudget > 0 ? (usedBudget / totalBudget * 100) : 0
                  
                  return (
                    <div key={project.id} className="space-y-1.5">
                      <div className="flex justify-between items-center">
                        <span className="text-sm font-medium text-gray-700 truncate">{project.name}</span>
                        <span className="text-sm font-bold text-gray-800">{usagePercent.toFixed(1)}%</span>
                      </div>
                      <div className="w-full bg-gray-200 rounded-full h-2">
                        <div 
                          className="bg-gradient-to-r from-blue-500 to-purple-600 h-2 rounded-full transition-all duration-300"
                          style={{ width: `${Math.min(usagePercent, 100)}%` }}
                        ></div>
                      </div>
                      <div className="flex justify-between text-xs text-gray-600">
                        <span>闂傚倸鍊峰ù鍥敋瑜嶉～婵嬫晝閸岋妇绋忔繝銏ｅ煐閸旀牠宕戦妶澶嬬厸闁搞儮鏅涘皬闂佺粯甯掗敃銉ф崲濞戙垹骞㈡俊顖濐嚙绾板秹姊? 濠电姷鏁告慨鎾儉婢舵劕绾ч幖瀛樻尭娴滅偓淇婇妶鍛殭妞?usedBudget / 10000).toFixed(1)}濠?/span>
                        <span>闂傚倸鍊搁崐鎼佸磹瀹勬噴褰掑炊椤掑鏅梺鍝勭▉閸樿偐绮堥崼鐔虹闁糕剝蓱鐏忋劑鏌嶈閸撱劎绮婚幘璇茬畺婵犲﹤鐗婇悡? 濠电姷鏁告慨鎾儉婢舵劕绾ч幖瀛樻尭娴滅偓淇婇妶鍛殭妞?totalBudget / 10000).toFixed(1)}濠?/span>
                      </div>
                    </div>
                  )
                })}
              </div>
            </div>
          </div>
        </>
      )}

      {/* 闂傚倸鍊搁崐鎼佸磹閹间礁纾归柟闂寸绾惧綊鏌ｉ幋锝呅撻柛濠傛健閺屻劑寮村鑸殿€栨繛瀛樼矊缂嶅﹪寮诲☉銏犵疀闁汇垽娼х敮鎺戔攽閻愬弶鈻曞ù婊勭矒閹€斥槈閵忥紕鍘卞┑鐐村灥瀹曨剟鐛鈧弻锝呪槈閺嵮冨闂佸疇顫夐崹鍧楀春閵夆晛骞㈡俊銈呭暕濞ｎ噣姊绘担渚劸妞ゆ垵妫濆畷婵單旀担铏瑰骄闂佸搫娲ㄩ崰鎾绘⒔閸曨垱鐓曟繝闈涘閸旀氨鎲搁弶鍨伃婵﹥妞介獮鏍倷閹绘帒顫戦梻浣告啞閺屻劎绮旈崜浣稿灊闁割偁鍎辩粈鍐┿亜閺冨倹娅曢柛?闂傚倸鍊搁崐鎼佸磹閹间礁纾归柟闂寸绾剧懓顪冪€ｎ亜顒㈡い鎰矙閺屻劑鎮㈤崫鍕戙垻鐥幆褜鐓奸柡灞剧洴閸╁嫰宕楅埡鍌氱伌鐎规洩缍€缁犳稑鈽夊▎鎴濆箥闂備浇顕栭崹鍗烆熆濡鏆遍梻鍌欒兌椤牓顢栭崱娆愬床闁告劦鍠栨闂佸憡娲﹂崹浼村礃閳ь剟姊洪棃娴ゆ盯宕ㄩ姘瑩缂傚倸鍊烽懗鍫曞磻閹捐纾块柟鎯版鍥撮梺褰掓？閻掞箓宕戦崒娑栦簻闁规澘澧庨悾閬嶆煟閹邦剨韬柡灞炬礃缁绘繆绠涢幙鍐╁枠婵＄偑鍊х拹鐔煎礉閹存繍娼栭柧蹇撴贡閻瑩鏌涢弽銈傚亾閸愬樊娼梻鍌欒兌椤牓顢栭崱娑欏剮妞ゆ牜鍋涢弰銉╂煏婢舵稓鐣辩紒鍓佸仱閺岀喖鏌囬敃鈧晶鐗堛亜閺冣偓鐢繝寮婚敐鍡樺劅闁靛繆鎳囨慨鍥⒑閹稿骸鍝洪柡宀嬬節瀹曞崬顫滈崱妯兼澒婵?- 婵犵數濮烽弫鍛婃叏閻戝鈧倿顢欓悙顒夋綗闂佸搫娲㈤崹鍦婵犳碍鐓欓弶鍫濆⒔閻ｈ京鐥幆褏绉洪柡宀嬬節瀹曞爼鍩℃担绋款棎闂備礁鍚嬪妯侯焽閿熺姴钃熸繛鎴烆焸閺冨牆绀冪憸蹇涙⒒椤栫偞鈷戠紓浣姑悘锕傛煥濮橆厹浜滈柡鍥舵線閹查箖鏌熼绛嬫當闁宠棄顦埢搴∥熼悡搴⌒ㄩ梻鍌欑閹诧繝寮婚妸鈺傚€舵慨妯块哺瀹曞弶绻濋棃娑卞剰妞ゎ偄鎳橀弻銊モ攽閸℃﹩妫ら梺闈涙閸旀洟鈥旈崘顔嘉ч柛鈩冾殘娴犳挳姊虹涵鍛彧闁挎洏鍨芥俊瀛樼瑹閳ь剙顕ｉ鈧畷鐓庮熆椤忓倸濮傞柡灞界Ч瀹曨偊宕熼鐔蜂壕濠电姵鑹鹃崒銊╂煕濡ゅ啫浜归柡鈧禒瀣厽婵☆垱顑欓崵瀣偓瑙勬偠閸庣敻寮诲☉銏″亞濞达綁鏅查崰濠囨⒑闂堟稒顥滈柛鐕佸亰閸┿垺鎯旈埥鍡楁闂侀潧绻掓繛鈧柛娆忓閳ь剝顫夊ú姗€宕曟總鍢庛劑宕掗悙鎼濡炪倖甯掗ˇ顖涙櫠椤栨稏浜滈柕濠忕到閸旓箓鏌熼鐣屾噰妤犵偛绉归、娆撳礈瑜嶆惔濠傗攽閿涘嫬浜奸柛濠冨灴瀹曞綊鎼归崷顓犵厯闂佺鎻拋锝囩礊閺嶃劎绡€闂傚牊绋掓径鍕磽瀹ュ懏鍠橀柡灞炬礃缁绘稖顦查柟鍙夌洴椤㈡宕掑鍜冪闯闂備胶顭堥張顒勬嚌妤ｅ啫鐒垫い鎺戝濡垿鏌熷畡閭﹀剶鐎殿喖顭锋俊鐑藉Ψ瑜濈槐閬嶆⒒娴ｇ儤鍤€濠⒀呮櫕閸掓帡顢涢悙鏉戜簵闂佺粯鏌ㄩ幉锟犲矗韫囨梹鍙忔俊銈傚亾婵☆偅顨嗛弲鑸电節濮橆厾鍘遍梺闈涚墕濞层倝寮搁弮鍌滅＜閺夊牄鍔屽ù顕€鏌涢埞鎯т壕婵＄偑鍊栫敮鎺斺偓姘煎墰缁牏鈧綆鍋佹禍婊堟煛瀹ュ啫濡块柕鍡樺浮閺屾稑顫滈埀顒佺鐠轰警娼栨繛宸簻缁犱即骞栧ǎ顒€鐏柛娆忔濮婃椽宕烽娑欏珱闂佺顑呴幊蹇曠矚鏉堛劎绡€闁告劦浜跺ù鍕煟鎼搭垳绉甸柛瀣瀹曘垺绂掔€ｎ偀鎷洪梺鍛婄箓鐎氼喛鍊撮梻浣芥〃閻掞箓骞冮崒鐐靛祦闁告劦鍠楅崵鍐煃閸濆嫬鏆熼柨娑欑矊椤啴濡堕崱妯锋嫽闂佺顑嗛幑鍥ь嚕閹剁瓔鏁嗛柛灞绢殔娴滈箖鎮峰▎蹇擃仾缂佸矁娉曠槐鎾愁吋閸曨厼濡芥繛锝呮搐閿曨亪骞冮崸妤婃晬闁挎繂鏌婇鍕拻濞达絿鍎ら崵鈧┑鈽嗗灠閿曘儳绮嬪澶樻晜闁告洖鐏氱紞搴♀攽閻愬弶鈻曞ù婊勭矋鐎靛ジ鎮╃紒妯煎幈闂佸搫娲㈤崝灞剧閹扮増鐓曢悗锝庡亝鐏忕敻鏌熸搴⌒㈤棁澶愭倵閿濆骸浜為柍褜鍓氬钘夘潖濞差亝顥堟繛鎴炴皑閻ゅ嫰姊洪幖鐐插婵＄偘绮欓弫?*/}
      {(isProcurementManager || isCostManager) && (
        <div className="space-y-2 mb-3 animate-fade-in-up" style={{ animationDelay: '0.7s' }}>
          {/* 婵犵數濮烽弫鍛婃叏閻戝鈧倿顢欓悙顒夋綗闂佸搫娲㈤崹鍦婵犳碍鐓欓弶鍫濆⒔閻ｈ京鐥幆褏绉洪柡宀嬬節瀹曞爼鍩℃担绋款棎闂備礁鍚嬪妯侯焽閿熺姴钃熸繛鎴烆焸閺冨牆绀冪憸蹇涙⒒椤栫偞鈷戠紓浣姑悘锕傛煥濮橆厹浜滈柡鍥舵線閹查箖鏌熼绛嬫當闁宠棄顦埢搴∥熼悡搴⌒ㄩ梻鍌欑閹诧繝寮婚妸鈺傚€舵慨妯块哺瀹曞弶绻濋棃娑卞剰妞ゎ偄鎳橀弻銊モ攽閸℃﹩妫ら梺闈涙閸旀洟鈥旈崘顔嘉ч柛鈩冾殘娴犳挳姊虹涵鍛彧闁挎洏鍨芥俊瀛樼瑹閳ь剙顕ｉ鈧畷鐓庮熆椤忓倸濮傞柡灞炬礃瀵板嫰宕煎┑鍫滅棯婵＄偑鍊ら崑鍕矓閻熼偊娼栨繛宸簻閹硅埖銇勯幘璺轰粧濠㈣娲熷娲川婵犲啫闉嶉悗鍏夊亾缂佸娉曢弳锕傛煛閸ャ儱鐏╃紒鐘崇⊕閵囧嫰骞嬮敐鍛呮捇鏌￠崒妤€浜?*/}
          <div className="modern-card p-3">
            <label className="block text-gray-700 font-medium mb-2 text-xs">{'\u5173\u8054\u9879\u76ee'}</label>
            <select
              className="modern-input w-full text-xs"
              value={selectedProject?.id || ''}
              onChange={(e) => {
                const project = projects.find(p => p.id === e.target.value)
                setSelectedProject(project)
              }}
            >
              <option value="">-- {'\u8bf7\u9009\u62e9\u9879\u76ee'} --</option>
              {projects.map((project) => (
                <option key={project.id} value={project.id}>
                  {project.name} ({'\u00A5'}{(Number(project.totalBudget || 0) / 10000).toFixed(1)}{'\u4e07'})
                </option>
              ))}
            </select>
          </div>
        </div>
      )}

      {/* 闂傚倸鍊搁崐鎼佸磹閹间礁纾归柟闂寸绾惧綊鏌ｉ幋锝呅撻柛濠傛健閺屻劑寮村鑸殿€栨繛瀛樼矊缂嶅﹪寮诲☉銏犵疀闁汇垽娼х敮鎺戔攽閻愬弶鈻曞ù婊勭矒閹€斥槈閵忥紕鍘卞┑鐐村灥瀹曨剟鐛鈧弻锝呪槈閺嵮冨闂佸疇顫夐崹鍧楀春閵夆晛骞㈡俊銈呭暕濞ｎ噣姊绘担渚劸妞ゆ垵妫濆畷婵單旀担铏瑰骄闂佸搫娲ㄩ崰鎾绘⒔閸曨垱鐓曟繝闈涘閸旀氨鎲搁弶鍨伃婵﹥妞介獮鏍倷閹绘帒顫戦梻浣告啞閺屻劎绮旈崜浣稿灊闁割偁鍎辩粈鍐┿亜閺冨倹娅曢柛?闂傚倸鍊搁崐鎼佸磹閹间礁纾归柟闂寸绾剧懓顪冪€ｎ亜顒㈡い鎰矙閺屻劑鎮㈤崫鍕戙垻鐥幆褜鐓奸柡灞剧洴閸╁嫰宕楅埡鍌氱伌鐎规洩缍€缁犳稑鈽夊▎鎴濆箥闂備浇顕栭崹鍗烆熆濡鏆遍梻鍌欒兌椤牓顢栭崱娆愬床闁告劦鍠栨闂佸憡娲﹂崹浼村礃閳ь剟姊洪棃娴ゆ盯宕ㄩ姘瑩缂傚倸鍊烽懗鍫曞磻閹捐纾块柟鎯版鍥撮梺褰掓？閻掞箓宕戦崒娑栦簻闁规澘澧庨悾閬嶆煟閹邦剨韬柡灞炬礃缁绘繆绠涢幙鍐╁枠婵＄偑鍊х拹鐔煎礉閹存繍娼栭柧蹇撴贡閻瑩鏌涢弽銈傚亾閸愬樊娼梻鍌欒兌椤牓顢栭崱娑欏剮妞ゆ牜鍋涢弰銉╂煏婢舵稓鐣辩紒鍓佸仱閺岀喖鏌囬敃鈧晶鐗堛亜閺冣偓鐢繝寮婚敐鍡樺劅闁靛繆鎳囨慨鍥⒑閹稿骸鍝洪柡宀嬬節瀹曞崬顫滈崱妯兼澒婵犳鍠栭敃锕傚磿閵堝拋鐒芥い蹇撴噹椤曢亶鎮楀☉娆欎緵闁逞屽墯閻楃姴顫忛搹鍦煓闁告牑鍓濋弫鍓х磽娴ｇ瓔鍤欓柛濠傛健閵嗕礁顫濋懜鍨珳闂佺硶鍓濋悷顖毭归崟顖涚厽閹兼惌鍨崇粔闈浢瑰鍛槐鐎规洘鍔欓幃娆撴倻濡攱瀚奸梻浣告啞閸旀洖顕ｉ崼鏇炵畾闁割偁鍎查悡銉╂煛閸ヮ煁顏堝焵椤掍胶澧垫鐐茬墦婵℃悂鍩￠崒姘綍闂備礁澹婇崑鍛垝鎼达絿涓嶆慨妯垮煐閳锋垹绱撴担濮戭亝鎱ㄩ敃鈧湁婵犲﹤瀚惌鎺楁煕閳规儳浜炬俊鐐€栫敮濠囨嚄閸撲胶涓嶉柟鐐暘娴滄粍銇勯幘璺轰沪缂佸本瀵ч妵鍕晝娓氬洦缍堥梺闈涙搐鐎氱増鎱ㄩ埀顒勬煃閵夈儱鏆遍柟鐣屾暬濮婃椽宕崟顔碱伃濠碘槅鍋呴〃濠囥€佸Ο鑽ら檮缂佸鐏濋懓鍨攽鎺抽崐鎾绘嚄閸洖绾?*/}
      {(isProcurementManager || isCostManager) && (
        <div className="modern-card mb-3 animate-fade-in-up" style={{ animationDelay: '0.75s' }}>
          <div className="flex border-b">
            <button
              onClick={() => setActiveTab('projects')}
              className={`flex-1 px-3 py-2 text-xs font-medium transition-colors ${
                activeTab === 'projects'
                  ? 'text-blue-600 border-b-2 border-blue-600 bg-blue-50'
                  : 'text-gray-600 hover:text-gray-800'
              }`}
            >
              <Business className="text-sm mr-1" />
